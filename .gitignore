# Virtual Environment
.venv/
venv/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Streamlit
.streamlit/

# User data and input videos (keep directory via .gitkeep)
data/input_videos/*
!data/input_videos/.gitkeep

# CSV logs (keep directory via .gitkeep)
results/logs/*
!results/logs/.gitkeep

# Exported batch videos (keep directory via .gitkeep)
results/exported_videos/*
!results/exported_videos/.gitkeep

# Local user/system files
.DS_Store
Thumbs.db
*.log
